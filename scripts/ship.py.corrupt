#!/usr/bin/env python3
"""Sunnyware — one-command fully automated ship.

Runs every quality + security check, bumps version, tags, pushes to GitHub
and Hugging Face, waits for HF rebuild, then verifies the live deployment.
Shows a clear pass/fail summary table at the end.

Usage:
  python scripts/ship.py                     # full pipeline
  python scripts/ship.py --dry-run           # preview only
  python scripts/ship.py --no-push           # commit + tag, no push
  python scripts/ship.py --skip-deploy       # skip post-deploy verification
  python scripts/ship.py --wait 180          # HF rebuild wait (seconds)
  python scripts/ship.py --message "..."     # custom commit message

Exit codes:
  0 = all passed
  1 = critical check failed (nothing pushed)
  2 = git push failed (committed locally)
  3 = post-deploy failed (pushed but live check failed)
"""
import argparse
import json
import re
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
REPORTS = REPO / "reports" / "latest"

# What counts as "critical" — must pass before we push
CRITICAL = {
    "bump_version", "system_monitor", "pre_push_check", "smoke_local",
    "security_pre_deploy", "verify_hashes", "commit_and_tag", "push_remotes",
}


def run(name, cmd, timeout=900):
    """Run a command, stream tail of output, return (ok, duration, stdout)."""
    print(f"\n{'═' * 70}")
    print(f"  ▶ {name}")
    print(f"{'═' * 70}")
    start = time.time()
    try:
        r = subprocess.run(
            cmd, cwd=REPO, capture_output=True, text=True, timeout=timeout,
        )
        dur = time.time() - start
        lines = (r.stdout or "").splitlines()
        for line in lines[-8:]:
            print(f"  {line}")
        if r.returncode != 0 and r.stderr:
            for line in r.stderr.splitlines()[-4:]:
                print(f"  ⚠️  {line}")
        return r.returncode == 0, dur, r.stdout or ""
    except subprocess.TimeoutExpired:
        print(f"  ⏱️  TIMEOUT after {timeout}s")
        return False, time.time() - start, ""
    except Exception as e:
        print(f"  ❌ {type(e).__name__}: {e}")
        return False, time.time() - start, ""


def read_version():
    init = REPO / "src" / "sunnyware" / "__init__.py"
    m = re.search(r'__version__\s*=\s*["\']([^"\']+)["\']',
                  init.read_text(encoding="utf-8"))
    return m.group(1) if m else "unknown"


def parse_manifest():
    mp = REPORTS / "MANIFEST.json"
    if not mp.exists():
        return {}
    try:
        return json.loads(mp.read_text(encoding="utf-8")).get("reports", {})
    except Exception:
        return {}


def print_summary(results, version, total_sec):
    """Print a clean summary table."""
    print(f"\n{'═' * 70}")
    print(f"  ��� SUNNYWARE SHIP SUMMARY — v{version}")
    print(f"{'═' * 70}\n")
    print(f"  {'Check':<30} {'Status':<8} {'Time':<8} {'Details'}")
    print(f"  {'-' * 30} {'-' * 8} {'-' * 8} {'-' * 30}")

    fails = []
    for name, status, dur, detail in results:
        icon = {"PASS": "✅", "WARN": "⚠️ ", "FAIL": "❌", "SKIP": "⏭️ "}[status]
        print(f"  {icon} {name:<27} {status:<8} {dur:>6.1f}s  {detail[:40]}")
        if status == "FAIL":
            fails.append(name)

    print(f"\n  ⏱️  Total: {total_sec:.1f}s")
    print(f"  ��� Version: v{version}")
    print(f"  ��� Reports: reports/latest/MANIFEST.json")
    print(f"  ��� Verify: python scripts/verify_attestations.py")

    if fails:
        print(f"\n  ❌ {len(fails)} failure(s): {', '.join(fails)}")
    else:
        print(f"\n  ��� All checks passed — ship successful!")
    print()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-push", action="store_true")
    ap.add_argument("--skip-deploy", action="store_true")
    ap.add_argument("--wait", type=int, default=180)
    ap.add_argument("--message", default=None)
    args = ap.parse_args()

    results = []
    t0 = time.time()

    # ═══ Phase 1: Local validation ════════════════════════════
    ok, dur, out = run("Bump version", [sys.executable, "scripts/bump_version.py"])
    results.append(("bump_version", "PASS" if ok else "FAIL", dur, ""))
    if not ok:
        print_summary(results, "?", time.time() - t0)
        return 1

    version = read_version()
    print(f"\n��� Target version: v{version}")

    if args.dry_run:
        print("\n��� DRY-RUN — aborting before attest (no files changed).")
        return 0

    # Attest runs all 6 quality + security scripts
    ok, dur, out = run("Attest all (6 scripts)", [sys.executable, "scripts/attest_all.py"])
    if not ok:
        results.append(("attest_all", "FAIL", dur, "see above"))
    else:
        results.append(("attest_all", "PASS", dur, "6 reports generated"))

    # Parse MANIFEST for per-report statuses
    reports = parse_manifest()
    for name, info in reports.items():
        exit_code = info.get("exit_code", 0)
        norm = info.get("normalized_exit", exit_code)
        if norm == 0 and exit_code == 0:
            status, detail = "PASS", f"exit=0"
        elif norm == 0 and exit_code == 2:
            status, detail = "WARN", f"exit=2 (warnings)"
        else:
            status, detail = "FAIL", f"exit={exit_code}"
        results.append((f"  {name}", status, 0, detail))

    # Verify hashes
    ok, dur, out = run("Verify hashes", [sys.executable, "scripts/verify_attestations.py"])
    results.append(("verify_hashes", "PASS" if ok else "FAIL", dur, ""))

    # Abort if any critical check failed
    critical_fail = [
        n for n, s, _, _ in results
        if s == "FAIL" and n.lstrip() in CRITICAL
    ]
    if critical_fail:
        print_summary(results, version, time.time() - t0)
        print(f"❌ Critical failures: {critical_fail}")
        print("   Nothing pushed. Fix the errors above and re-run.")
        return 1

    # ═══ Phase 2: Commit + tag + push ═════════════════════════
    if args.no_push:
        print("\n⏭️  --no-push: stopping before commit.")
        print_summary(results, version, time.time() - t0)
        return 0

    msg = args.message or f"chore(release): v{version}"
    ok1, dur, _ = run("git add", ["git", "add", "-A"])
    ok2, _, _ = run("git commit", ["git", "commit", "-m", msg])
    ok3, _, _ = run("git tag", ["git", "tag", "-a", f"v{version}", "-m", f"Release v{version}"])
    commit_ok = ok1 and ok2 and ok3
    results.append(("commit_and_tag", "PASS" if commit_ok else "FAIL", dur, f"v{version}"))
    if not commit_ok:
        print_summary(results, version, time.time() - t0)
        return 1

    ok_g, dur, _ = run("push origin main", ["git", "push", "origin", "main"])
    ok_h, _, _ = run("push hf main", ["git", "push", "hf", "main"])
    ok_t, _, _ = run("push tag", ["git", "push", "origin", f"v{version}"])
    push_ok = ok_g and ok_h and ok_t
    results.append(("push_remotes", "PASS" if push_ok else "FAIL", dur, ""))
    if not push_ok:
        print_summary(results, version, time.time() - t0)
        print("❌ Push failed — fix remote access and retry.")
        return 2

    # ═══ Phase 3: Post-deploy verification ════════════════════
    if not args.skip_deploy:
        print(f"\n⏱️  Waiting {args.wait}s for HF rebuild...")
        time.sleep(args.wait)

        ok, dur, _ = run("Post-deploy smoke", [sys.executable, "scripts/smoke_remote.py"])
        results.append(("post_deploy_smoke", "PASS" if ok else "WARN", dur,
                        "SHA may still mismatch" if not ok else ""))

        ok, dur, _ = run("Post-deploy security", [sys.executable, "scripts/security_post_deploy.py"])
        results.append(("post_deploy_security", "PASS" if ok else "WARN", dur, ""))

    # ═══ Summary ══════════════════════════════════════════════
    print_summary(results, version, time.time() - t0)
    fails = [n for n, s, _, _ in results if s == "FAIL"]
    return 3 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
