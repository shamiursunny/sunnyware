# ─── Database ───────────────────────────────────────────────────────────────
NEON_DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─── LLM Backend (choose one) ───────────────────────────────────────────────

# Option A: Local Ollama (dev)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma2-2b-tuned-stable:latest

# Option B: Groq (production / HF Space)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=openai/gpt-oss-20b

# Option C: OpenAI (paid)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# Option D: HF Inference (free tier)
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# ─── Tool Calling Mode (optional) ───────────────────────────────────────────
# LLM_NATIVE_TOOLS=true   → use OpenAI native tool calling (Groq, OpenAI, Mistral)
# LLM_NATIVE_TOOLS=false  → use prompt-based JSON protocol (Ollama, small models)
# Unset → auto-detect by LLM_BASE_URL
# LLM_NATIVE_TOOLS=false
