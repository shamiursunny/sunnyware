# ─── Database ───────────────────────────────────────────────────────────────
NEON_DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─── LLM — Multi-provider router (Part 32) ─────────────────────────────────
# Priority order (comma-separated). The router tries each in order,
# skipping any provider that is currently cooling down (rate-limited).
# If ALL providers fail, the request returns a clear error.
#
# If LLM_PROVIDERS is unset, the legacy single-provider mode is used
# (LLM_BASE_URL / LLM_API_KEY / LLM_MODEL below).

# ── Preferred: multi-provider ──
# LLM_PROVIDERS=groq,gemini,openrouter,local

# Provider: Groq (fastest; free 200K tokens/day)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=openai/gpt-oss-20b

# Provider: Google Gemini (free 1.5K req/day)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.0-flash

# Provider: OpenRouter (free 50 req/day; 1000 with $10 topup)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Provider: Local llama.cpp (unlimited; runs inside HF Space)
# LOCAL_BASE_URL=http://localhost:8080/v1
# LOCAL_API_KEY=local
# LOCAL_MODEL=minicpm5-2b

# ── Legacy: single provider ──
# Option A: Local Ollama (dev)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma2-2b-tuned-stable:latest

# Option B: Groq only
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=openai/gpt-oss-20b

# ─── Tool Calling Mode (optional) ───────────────────────────────────────────
# LLM_NATIVE_TOOLS=true   → native tool calling (Groq, OpenAI, Gemini)
# LLM_NATIVE_TOOLS=false  → prompt-based JSON (Ollama, small local models)
# Unset → auto-detect by LLM_BASE_URL
# LLM_NATIVE_TOOLS=false

# ─── Workspace (optional) ────────────────────────────────────────────────────
# SUNNYWARE_WORKSPACE=./data/workspace

# ─── Local model (Part 32 Phase 2) ──────────────────────────────────────────
# Path to the GGUF file inside the container (mounted from a bucket)
# LOCAL_MODEL_PATH=/data/models/MiniCPM5-2B-Q4_K_M.gguf
# Disable launcher with:
# LOCAL_MODEL_ENABLED=0


# ─── Model auto-resolver (Part 33) ──────────────────────────────────────────
# When ON (default), Sunnyware probes each provider's /models endpoint at
# first use and auto-picks the best available model from a preference list.
# If your configured model is retired or unavailable, the router adapts.
#
# MODEL_AUTORESOLVE=1   # default; set to 0 to use configured model verbatim

# Part 97: Pollinations AI free-tier fallback provider
# No API key needed for anonymous tier (use 'pollinations' dummy)
# Sign up at https://enter.pollinations.ai for higher rate limits
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_API_KEY=pollinations
POLLINATIONS_MODEL=openai
